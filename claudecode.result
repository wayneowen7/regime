 Bash command

   cat << 'PYEOF' | ssh lenovo@10.147.18.151 "cat > /home/lenovo/code/regime_collapse_pilot/scripts/run_pilot_mem0.py"
   """
   Pilot Experiment: Regime Collapse in Mem0
   Tests whether Mem0 retrieves relevant-but-invalid memories after regime shift.

   Flow:
   1. Phase 1: Agent operates under Regime A, interactions stored in Mem0
   2. Regime shift: system prompt changes to Regime B
   3. Phase 2: Agent receives similar queries under Regime B
   4. Measure: Does the agent use old memories and behave incorrectly?
   """

   import json
   import os
   import sys
   import time
   import shutil
   from datetime import datetime

   import ollama
   from mem0 import Memory

   sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
   from scenarios.pilot_scenarios import ALL_SCENARIOS

   RESULTS_DIR = "/home/lenovo/code/regime_collapse_pilot/results"
   LLM_MODEL = "qwen2.5:14b"
   EMBED_MODEL = "nomic-embed-text"
   USER_ID = "test_agent"


   def setup_mem0():
       """Initialize Mem0 with local ollama backend."""
       config = {
           "llm": {
               "provider": "ollama",
               "config": {
                   "model": LLM_MODEL,
                   "temperature": 0.0,
                   "max_tokens": 1024,
               },
           },
           "embedder": {
               "provider": "ollama",
               "config": {
                   "model": EMBED_MODEL,
               },
           },
           "vector_store": {
               "provider": "qdrant",
               "config": {
                   "collection_name": "regime_pilot",
                   "embedding_model_dims": 768,
                   "path": "/tmp/qdrant_regime_pilot",
               },
           },
           "version": "v1.1",
       }
       # clean previous state
       qdrant_path = "/tmp/qdrant_regime_pilot"
       if os.path.exists(qdrant_path):
           shutil.rmtree(qdrant_path)
       history_path = os.path.expanduser("~/.mem0/history.db")
       if os.path.exists(history_path):
           os.remove(history_path)

       return Memory.from_config(config)


   def llm_generate(system_prompt: str, user_msg: str, memory_context: str = "") -> str:
       """Generate response using ollama with optional memory context."""
       messages = [{"role": "system", "content": system_prompt}]
       if memory_context:
           messages.append({
               "role": "system",
               "content": f"Relevant past experiences:\n{memory_context}",
           })
       messages.append({"role": "user", "content": user_msg})

       resp = ollama.chat(model=LLM_MODEL, messages=messages, options={"temperature": 0.0})
       return resp["message"]["content"]


   def run_phase1(mem: Memory, scenario: dict) -> list:
       """Phase 1: Build memories under Regime A."""
       print(f"\n{'='*60}")
       print(f"PHASE 1: {scenario['regime_a']['name']}")
       print(f"{'='*60}")

       records = []
       system_prompt = scenario["regime_a"]["system_prompt"]

       for i, interaction in enumerate(scenario["phase1_interactions"]):
           print(f"\n--- Interaction {i+1}/{len(scenario['phase1_interactions'])} ---")
           print(f"User: {interaction['user'][:80]}...")

           response = llm_generate(system_prompt, interaction["user"])
           print(f"Agent: {response[:120]}...")

           conversation = f"User: {interaction['user']}\nAgent: {response}"
           mem_result = mem.add(
               conversation,
               user_id=USER_ID,
               metadata={"regime": scenario["regime_a"]["name"], "phase": "construction"},
           )

           records.append({
               "phase": 1,
               "interaction_idx": i,
               "user_input": interaction["user"],
               "agent_response": response,
               "expected_behavior": interaction["expected_behavior"],
               "memory_result": str(mem_result),
               "regime": scenario["regime_a"]["name"],
           })

       return records


   def run_phase2(mem: Memory, scenario: dict) -> list:
       """Phase 2: Test under Regime B with old memories."""
       print(f"\n{'='*60}")
       print(f"PHASE 2: {scenario['regime_b']['name']} (regime shifted!)")
       print(f"{'='*60}")

       records = []
       system_prompt = scenario["regime_b"]["system_prompt"]

       for i, query in enumerate(scenario["phase2_queries"]):
           print(f"\n--- Query {i+1}/{len(scenario['phase2_queries'])} ---")
           print(f"User: {query['user'][:80]}...")

           # 1. Search Mem0 for relevant memories
           search_results = mem.search(query["user"], user_id=USER_ID, limit=5)
           memories_text = ""
           retrieved_memories = []
           if search_results and "results" in search_results:
               for r in search_results["results"]:
                   mem_text = r.get("memory", "")
                   mem_score = r.get("score", 0)
                   mem_meta = r.get("metadata", {})
                   memories_text += f"- {mem_text}\n"
                   retrieved_memories.append({
                       "memory": mem_text,
                       "score": mem_score,
                       "metadata": mem_meta,
                   })
           elif isinstance(search_results, list):
               for r in search_results:
                   mem_text = r.get("memory", "") if isinstance(r, dict) else str(r)
                   memories_text += f"- {mem_text}\n"
                   retrieved_memories.append({"memory": mem_text})

           print(f"Retrieved {len(retrieved_memories)} memories")
           for rm in retrieved_memories:
               print(f"  MEM: {str(rm.get('memory', ''))[:100]}...")

           # 2. Generate response WITH memories (the realistic case)
           response_with_mem = llm_generate(system_prompt, query["user"], memories_text)
           print(f"Agent (with memory): {response_with_mem[:120]}...")

           # 3. Generate response WITHOUT memories (baseline)
           response_no_mem = llm_generate(system_prompt, query["user"], "")
           print(f"Agent (no memory):   {response_no_mem[:120]}...")

           # 4. Check for regime-A behavior signals in response
           response_lower = response_with_mem.lower()
           triggered_signals = [
               s for s in query["regime_b_incorrect_signals"]
               if s.lower() in response_lower
           ]
           baseline_lower = response_no_mem.lower()
           baseline_signals = [
               s for s in query["regime_b_incorrect_signals"]
               if s.lower() in baseline_lower
           ]

           is_regime_collapse = len(triggered_signals) > 0
           baseline_would_fail = len(baseline_signals) > 0
           memory_made_it_worse = is_regime_collapse and not baseline_would_fail

           print(f"Incorrect signals (with mem): {triggered_signals}")
           print(f"Incorrect signals (no mem):   {baseline_signals}")
           print(f"REGIME COLLAPSE: {is_regime_collapse}")
           print(f"MEMORY MADE IT WORSE: {memory_made_it_worse}")

           records.append({
               "phase": 2,
               "query_idx": i,
               "user_input": query["user"],
               "response_with_memory": response_with_mem,
               "response_no_memory": response_no_mem,
               "retrieved_memories": retrieved_memories,
               "regime_b_correct": query["regime_b_correct"],
               "regime_a_response": query["regime_a_response"],
               "incorrect_signals": query["regime_b_incorrect_signals"],
               "triggered_signals_with_mem": triggered_signals,
               "triggered_signals_no_mem": baseline_signals,
               "is_regime_collapse": is_regime_collapse,
               "memory_made_it_worse": memory_made_it_worse,
               "tests_memory": query["tests_memory"],
               "regime": scenario["regime_b"]["name"],
           })

       return records


   def analyze_results(phase2_records: list, scenario_name: str) -> dict:
       """Compute pilot metrics."""
       total = len(phase2_records)
       regime_collapse_count = sum(1 for r in phase2_records if r["is_regime_collapse"])
       memory_worse_count = sum(1 for r in phase2_records if r["memory_made_it_worse"])
       baseline_fail_count = sum(1 for r in phase2_records if r["triggered_signals_no_mem"])

       # invalid memory activation: memories from regime_a retrieved during regime_b
       total_retrieved = sum(len(r["retrieved_memories"]) for r in phase2_records)

       metrics = {
           "scenario": scenario_name,
           "total_queries": total,
           "regime_collapse_rate": regime_collapse_count / total if total else 0,
           "regime_collapse_count": regime_collapse_count,
           "memory_made_worse_rate": memory_worse_count / total if total else 0,
           "memory_made_worse_count": memory_worse_count,
           "baseline_fail_rate": baseline_fail_count / total if total else 0,
           "total_memories_retrieved": total_retrieved,
       }

       print(f"\n{'='*60}")
       print(f"METRICS: {scenario_name}")
       print(f"{'='*60}")
       for k, v in metrics.items():
           if isinstance(v, float):
               print(f"  {k}: {v:.1%}")
           else:
               print(f"  {k}: {v}")

       return metrics


   def main():
       os.makedirs(RESULTS_DIR, exist_ok=True)
       timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

       all_results = {}

       for scenario in ALL_SCENARIOS:
           print(f"\n{'#'*60}")
           print(f"# SCENARIO: {scenario['name']}")
           print(f"{'#'*60}")

           # fresh mem0 for each scenario
           mem = setup_mem0()

           phase1_records = run_phase1(mem, scenario)
           phase2_records = run_phase2(mem, scenario)
           metrics = analyze_results(phase2_records, scenario["name"])

           # dump all memories in mem0 after experiment
           all_memories = mem.get_all(user_id=USER_ID)

           all_results[scenario["name"]] = {
               "phase1": phase1_records,
               "phase2": phase2_records,
               "metrics": metrics,
               "all_memories_after": str(all_memories),
           }

       # save results
       outfile = os.path.join(RESULTS_DIR, f"pilot_mem0_{timestamp}.json")
       with open(outfile, "w") as f:
           json.dump(all_results, f, indent=2, ensure_ascii=False, default=str)
       print(f"\nResults saved to {outfile}")

       # print summary
       print(f"\n{'='*60}")
       print("PILOT SUMMARY")
       print(f"{'='*60}")
       for name, data in all_results.items():
           m = data["metrics"]
           print(f"\n{name}:")
