      204 def compute_metrics(phase2_records: list) -> dict:
      205     """Compute pilot metrics."""
      206     n = len(phase2_records)
      207     if n == 0:
      208         return {}
      209
      210     # Invalid Memory Activation Rate (IMAR): fraction of queries where retrieved
      211     # memories led to regime-A behavior
      212     collapse_with_mem = sum(1 for r in phase2_records if r["regime_collapse_with_mem"])
      213     collapse_no_mem = sum(1 for r in phase2_records if r["regime_collapse_no_mem"])
      214
      215     # Memory-induced error: cases where memory caused collapse but baseline didn't
      216     memory_induced = sum(
      217         1 for r in phase2_records
      218         if r["regime_collapse_with_mem"] and not r["regime_collapse_no_mem"]
      219     )
      220
      221     return {
      222         "total_queries": n,
      223         "collapse_rate_with_memory": collapse_with_mem / n,
      224         "collapse_rate_no_memory": collapse_no_mem / n,
      225         "memory_induced_error_rate": memory_induced / n,
      226         "collapse_with_mem_count": collapse_with_mem,
      227         "collapse_no_mem_count": collapse_no_mem,
      228         "memory_induced_count": memory_induced,
      229     }
      230
      231
      232 def run_scenario(scenario: dict) -> dict:
      233     """Run full pilot for one scenario."""
      234     print(f"\n{'#'*60}")
      235     print(f"SCENARIO: {scenario['name']}")
      236     print(f"{'#'*60}")
      237
      238     mem = setup_mem0()
      239
      240     # Phase 1
      241     phase1_records = run_phase1(mem, scenario)
      242     print(f"\nPhase 1 complete. {len(phase1_records)} memories stored.")
      243
      244     # Check what's in memory
      245     all_memories = mem.get_all(user_id=USER_ID)
      246     print(f"Total memories in store: {len(all_memories) if isinstance(all_memories, list) else 'unknown'}")
      247
      248     # Phase 2
      249     phase2_records = run_phase2(mem, scenario)
      250
      251     # Metrics
      252     metrics = compute_metrics(phase2_records)
      253     print(f"\n{'='*60}")
      254     print(f"METRICS for {scenario['name']}:")
      255     print(f"  Collapse rate WITH memory:  {metrics['collapse_rate_with_memory']:.1%} ({metrics['collapse_with_mem_count']}
          /{metrics['total_queries']})")
      256     print(f"  Collapse rate NO memory:    {metrics['collapse_rate_no_memory']:.1%} ({metrics['collapse_no_mem_count']}/{me
          trics['total_queries']})")
      257     print(f"  Memory-induced error rate:  {metrics['memory_induced_error_rate']:.1%} ({metrics['memory_induced_count']}/{m
          etrics['total_queries']})")
      258     print(f"{'='*60}")
      259
      260     return {
      261         "scenario": scenario["name"],
      262         "phase1_records": phase1_records,
      263         "phase2_records": phase2_records,
      264         "metrics": metrics,
      265         "timestamp": datetime.now().isoformat(),
      266     }
      267
